<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_light" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="10dp">

        <!-- 卡片1：数据来源 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="8dp">
                <TextView android:id="@+id/tvSourceHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="数据来源" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/text_primary" android:layout_marginBottom="2dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="可多选，点击切换" android:textSize="11sp"
                    android:textColor="@color/text_secondary" android:layout_marginBottom="8dp" />
                <GridLayout android:id="@+id/gridSource" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:columnCount="2" android:rowCount="5">
                <com.google.android.material.button.MaterialButton android:id="@+id/srcIgp" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:minWidth="0dp" android:text="iGPSPORT" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:tag="igp" app:backgroundTint="@color/bg_light" app:cornerRadius="14dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/srcXz" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:minWidth="0dp" android:text="行者" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:tag="xz" app:backgroundTint="@color/xingzhe_blue" app:cornerRadius="14dp" android:textColor="@color/white" />
                <com.google.android.material.button.MaterialButton android:id="@+id/srcMg" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:minWidth="0dp" android:text="迈金" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:tag="mg" app:backgroundTint="@color/bg_light" app:cornerRadius="14dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/srcBb" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:minWidth="0dp" android:text="黑鸟" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:tag="bb" app:backgroundTint="@color/bg_light" app:cornerRadius="14dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/srcBr" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:minWidth="0dp" android:text="百锐腾·开发中" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:tag="br" app:backgroundTint="@color/bg_light" app:cornerRadius="14dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/srcGm" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:minWidth="0dp" android:text="佳明国际" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:tag="gm" app:backgroundTint="@color/bg_light" app:cornerRadius="14dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/srcGcn" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:minWidth="0dp" android:text="佳明中国" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:tag="gcn" app:backgroundTint="@color/bg_light" app:cornerRadius="14dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/srcCscn" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:minWidth="0dp" android:text="高驰中国" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:tag="cscn" app:backgroundTint="@color/bg_light" app:cornerRadius="14dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/srcCs" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:minWidth="0dp" android:text="高驰国际" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:tag="cs" app:backgroundTint="@color/bg_light" app:cornerRadius="14dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/srcWahoo" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:minWidth="0dp" android:text="Wahoo" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:tag="wo" app:backgroundTint="@color/bg_light" app:cornerRadius="14dp" android:textColor="@color/text_primary" />
                </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 卡片2：同步目标（固定）-->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:id="@+id/tvTargetHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="同步目标" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/text_primary" android:layout_marginBottom="8dp" />
                <GridLayout android:id="@+id/gridTarget" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:columnCount="1">
                <com.google.android.material.button.MaterialButton android:id="@+id/tgtOb"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:minWidth="0dp"
                    android:text="Outbase" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"
                    android:tag="ob" app:backgroundTint="@color/primary_soft" app:cornerRadius="14dp"
                    android:textColor="@color/primary_dark" />
                </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 卡片3：同步数量 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="同步数量" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/text_primary" android:layout_marginBottom="2dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="同步数量" android:textSize="13sp" android:textColor="@color/text_secondary" />
                    <com.google.android.material.slider.Slider android:id="@+id/sliderCount"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                        android:valueFrom="1" android:valueTo="1000" android:stepSize="1" android:value="20"
                        app:thumbColor="@color/primary" app:trackColorActive="@color/primary" app:trackColorInactive="@color/bg_line" />
                    <TextView android:id="@+id/tvCount" android:layout_width="56dp" android:layout_height="wrap_content"
                        android:text="20" android:textSize="15sp" android:textStyle="bold" android:gravity="center"
                        android:textColor="@color/primary_dark" android:background="@drawable/input_box_bg"
                        android:paddingTop="3dp" android:paddingBottom="3dp"
                        android:clickable="true" android:focusable="true" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="跳过前N条" android:textSize="13sp" android:textColor="@color/text_secondary" />
                    <com.google.android.material.slider.Slider android:id="@+id/sliderSkip"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                        android:valueFrom="0" android:valueTo="10000" android:stepSize="1" android:value="0"
                        app:thumbColor="@color/primary" app:trackColorActive="@color/primary" app:trackColorInactive="@color/bg_line" />
                    <TextView android:id="@+id/tvSkip" android:layout_width="56dp" android:layout_height="wrap_content"
                        android:text="0" android:textSize="15sp" android:textStyle="bold" android:gravity="center"
                        android:textColor="@color/primary_dark" android:background="@drawable/input_box_bg"
                        android:paddingTop="3dp" android:paddingBottom="3dp"
                        android:clickable="true" android:focusable="true" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 卡片4：数据处理 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="数据处理" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/text_primary" android:layout_marginBottom="4dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="迈金坐标转换" android:textSize="14sp" android:textColor="@color/text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="GCJ-02 → WGS84" android:textSize="12sp" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchGcj02"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/bg_line" android:layout_marginTop="6dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="忽略记忆，强制重传" android:textSize="14sp" android:textColor="@color/text_primary" />
                        <TextView android:id="@+id/tvForceRetransmitHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="已关闭" android:textSize="12sp" android:textColor="@color/text_secondary" android:maxLines="2" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchForceRetransmit"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 卡片5：日期过滤 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="日期过滤" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/text_primary" android:layout_marginBottom="4dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="仅同步指定日期之前" android:textSize="14sp" android:textColor="@color/text_primary" />
                        <TextView android:id="@+id/tvCutoffHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="12sp" android:textColor="@color/text_secondary" android:maxLines="2" />
                    </LinearLayout>
                    <TextView android:id="@+id/tvCutoffDate" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="点击选择日期" android:textSize="13sp"
                        android:textStyle="bold" android:textColor="@color/primary_dark"
                        android:background="@drawable/input_box_bg" android:paddingStart="10dp" android:paddingEnd="10dp"
                        android:paddingTop="5dp" android:paddingBottom="5dp"
                        android:clickable="true" android:focusable="true" />
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchDateCutoff"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 卡片6：存储 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="6dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="存储" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/text_primary" android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/tvSaveDir" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textSize="12sp" android:textColor="@color/text_secondary"
                        android:maxLines="1" android:ellipsize="middle" />
                    <TextView android:id="@+id/btnOpenSaveDir" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="打开目录" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="@color/primary_dark"
                        android:background="@drawable/input_box_bg" android:paddingStart="10dp" android:paddingEnd="10dp"
                        android:paddingTop="5dp" android:paddingBottom="5dp"
                        android:clickable="true" android:focusable="true" />
                </LinearLayout>
                <TextView android:id="@+id/tvSyncedCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
