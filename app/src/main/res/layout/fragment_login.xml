<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- v8.4.0: 顶部品牌横幅（对齐开发版 8.3.3） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_login_banner"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="迈向Ob"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="让运动数据自由流动"
                android:textColor="#E6FFFFFF"
                android:textSize="10sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="选择平台登录，统一上传到 Outbase"
                android:textColor="#BFFFFFFF"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- v8.4.0: Outbase 固定卡（始终显示、不可收起、默认选中） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOutbaseFixed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#BFD9FF"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot_outbase" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Outbase"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:maxLines="1" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvOutbaseStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="未登录"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/btnOutbaseLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="登录Outbase"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:background="@drawable/primary_btn_bg"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- v8.4.0: 一键检测卡（对齐开发版 8.3.3） -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#E3EEFA"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp" android:paddingTop="6dp" android:paddingEnd="8dp" android:paddingBottom="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="一键登录检测" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckAll"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:insetTop="0dp" android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:text="检测" android:textSize="11sp"
                        app:backgroundTint="@color/primary" app:cornerRadius="10dp" />
                </LinearLayout>
                <TextView android:id="@+id/tvCheckStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="检测全部已登录平台的登录态（网络请求，约几秒）" android:textSize="9sp" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/tvCheckSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/green" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="自动检查登录态（会话内一次，后台静默）" android:textSize="9sp" android:textColor="@color/text_secondary" />
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchAutoCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" android:minHeight="0dp" android:scaleX="0.7" android:scaleY="0.7" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- v8.4.0: 已登录平台分组标题 -->
        <TextView
            android:id="@+id/tvGroupLogged"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:paddingStart="4dp"
            android:text="已登录平台"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <!-- v8.4.0: 已登录平台卡片容器（程序化构建，每行2个） -->
        <LinearLayout
            android:id="@+id/containerLogged"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- v8.4.0: 未登录折叠条 -->
        <LinearLayout
            android:id="@+id/llFoldToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_check_update"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tvFoldToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="未登录平台"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />
            <TextView
                android:id="@+id/tvFoldArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▾ 点击展开"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />
        </LinearLayout>

        <!-- v8.4.0: 未登录平台卡片容器（程序化构建，默认折叠隐藏） -->
        <LinearLayout
            android:id="@+id/containerLoggedOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
